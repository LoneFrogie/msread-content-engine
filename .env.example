# MS. READ Content Engine — Environment Variables
# Copy this file to .env and add your API key.
#
# Get a free Google AI key at: https://aistudio.google.com/apikey

GOOGLE_AI_API_KEY=your-api-key-here

# ── Optional upgrades (CONTENT + tab) ──
# Better strategy copy: if set, CONTENT + writes the brief with Claude,
# otherwise it falls back to Gemini (always works with just the Google key).
# ANTHROPIC_API_KEY=
# CONTENT_PLUS_CLAUDE_MODEL=claude-opus-4-6

# Premium viral motion: if set, CONTENT + renders clips through Higgsfield's
# official DoP image-to-video API (cinematic camera motion); otherwise it falls
# back to Google Veo 3.1. Get an id + secret at cloud.higgsfield.ai -> API Keys.
# Provide EITHER the combined form OR the split form:
# HF_KEY=your-key-id:your-key-secret
# HF_API_KEY=your-key-id
# HF_API_SECRET=your-key-secret
# HIGGSFIELD_API_BASE=https://platform.higgsfield.ai
# HIGGSFIELD_DOP_ENDPOINT=/higgsfield-ai/dop/standard
